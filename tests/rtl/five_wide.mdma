    CONST -> STASH_A, CONST -> STASH_B, CONST -> STASH_C, CONST -> STASH_D, CONST -> STACK_A
    CONST -> STASH_A, CONST -> STASH_B, CONST -> STASH_C, CONST -> STASH_D, CONST -> STACK_A [imm=2]
    CONST -> STASH_A, CONST -> STASH_B, CONST -> STASH_C, CONST -> STASH_D, CONST -> STACK_A [imm=3]
    CONST -> STASH_A, CONST -> STASH_B, CONST -> STASH_C, CONST -> STASH_D, CONST -> STACK_A [imm=4]
first_dispatch:
    STASH_A -> ARITH_A.LHS, STASH_B -> ARITH_A.RHS, STASH_C -> LOGIC_A.LHS, STASH_D -> LOGIC_A.RHS, STACK_A -> SHIFT_A.VAL [sync]
second_dispatch:
    STASH_A -> ARITH_A.LHS, STASH_B -> ARITH_A.RHS, STASH_C -> LOGIC_B.LHS, STASH_D -> LOGIC_B.RHS, STACK_A -> SHIFT_B.VAL [sync, imm=9]
    CONST -> PC [imm=first_dispatch]
