# expect mem64 __mdma_result = 496
function w $work(l %x, l %y, l %z, l %w) {
@start
    %a =l mul %x, 3
    %b =l mul %y, 7
    %c =l mul %z, 13
    %d =l mul %w, 19
    %t1 =l add %d, 23
    %t2 =l xor %t1, %c
    %t3 =l xor %t2, %b
    %t4 =l xor %t3, %a
    %r =w copy %t4
    ret %r
}

export function w $main() {
@start
    %r =w call $work(l 2, l 5, l 11, l 17)
    ret %r
}
