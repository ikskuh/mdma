# expect mem64 __mdma_result = 1
function l $signed_half(l %p) {
@start
    %value =l loadsh %p
    ret %value
}

export function w $main() {
@start
    %p =l alloc16 32
    %q =l add %p, 7
    storeb 85, %p
    storel 72623859790382856, %q
    %v =l loadl %q
    %ok1 =w ceql %v, 72623859790382856
    %first =w loadub %p
    %ok2 =w ceqw %first, 85
    %dest =l add %p, 17
    blit %q, %dest, 8
    %v2 =l loadl %dest
    %ok3 =w ceql %v2, %v
    %neg =l add %p, 29
    storeh -2, %neg
    %signed =l call $signed_half(l %neg)
    %ok4 =w ceql %signed, -2
    %cross =l add %p, 15
    storeh -257, %cross
    %split =l call $signed_half(l %cross)
    %ok6 =w ceql %split, -257
    %neighbor =w loadub %dest
    %ok7 =w ceqw %neighbor, 8
    %a =w and %ok1, %ok2
    %b =w and %ok3, %ok4
    %low =w loadw %q
    %ok5 =w ceqw %low, 84281096
    %c =w and %a, %b
    %d =w and %ok5, %ok6
    %checks =w and %c, %d
    %result =w and %checks, %ok7
    ret %result
}
