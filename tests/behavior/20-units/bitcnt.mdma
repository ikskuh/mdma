# BITCNT counts set bits and zeros at either end, including a zero input.
# expect mem64 popcount = 2
# expect mem64 leading_zeros = 58
# expect mem64 trailing_zeros = 3
# expect mem64 zero_ctz = 64
# expect mem64 zero_clz = 64

CONST -> BITCNT [imm=40]
CONST -> MEM.WRITE [imm=popcount]
BITCNT.POP -> MEM.CHUNK, ZERO -> MEM.MASK [sync]
CONST -> BITCNT [imm=40]
CONST -> MEM.WRITE [imm=leading_zeros]
BITCNT.CLZ -> MEM.CHUNK, ZERO -> MEM.MASK [sync]
CONST -> BITCNT [imm=40]
CONST -> MEM.WRITE [imm=trailing_zeros]
BITCNT.CTZ -> MEM.CHUNK, ZERO -> MEM.MASK [sync]
CONST -> BITCNT [imm=0]
CONST -> MEM.WRITE [imm=zero_ctz]
BITCNT.CTZ -> MEM.CHUNK, ZERO -> MEM.MASK [sync]
CONST -> BITCNT [imm=0]
CONST -> MEM.WRITE [imm=zero_clz]
BITCNT.CLZ -> MEM.CHUNK, ZERO -> MEM.MASK [sync]

CONST -> MEM.READ [imm=zero_clz]
MEM.CHUNK -> DISCARD
CONST -> PC [imm=-1]

popcount: .word 0xfeedfacefeedface
leading_zeros: .word 0xfeedfacefeedface
trailing_zeros: .word 0xfeedfacefeedface
zero_ctz: .word 0xfeedfacefeedface
zero_clz: .word 0xfeedfacefeedface
