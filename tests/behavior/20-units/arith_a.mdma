# ARITH_A wraps the sum and computes left minus right.
# expect mem64 sum = 1
# expect mem64 difference = -3

CONST -> ARITH_A.LHS [imm=-1]
CONST -> ARITH_A.RHS [imm=2]
CONST -> MEM.WRITE [imm=sum]
ARITH_A.ADD -> MEM.CHUNK, ZERO -> MEM.MASK [sync]

CONST -> ARITH_A.LHS [imm=-1]
CONST -> ARITH_A.RHS [imm=2]
CONST -> MEM.WRITE [imm=difference]
ARITH_A.SUB -> MEM.CHUNK, ZERO -> MEM.MASK [sync]

CONST -> MEM.READ [imm=difference]
MEM.CHUNK -> DISCARD
CONST -> PC [imm=-1]

sum: .word 0xfeedfacefeedface
difference: .word 0xfeedfacefeedface
