# STASH_C retains 2 values and returns them in FIFO order.
# expect mem64 pop_1 = 1
# expect mem64 pop_2 = 2

CONST -> STASH_C [imm=1]
CONST -> STASH_C [imm=2]
CONST -> MEM.WRITE [imm=pop_1]
STASH_C -> MEM.CHUNK, ZERO -> MEM.MASK [sync]
CONST -> MEM.WRITE [imm=pop_2]
STASH_C -> MEM.CHUNK, ZERO -> MEM.MASK [sync]

CONST -> MEM.READ [imm=pop_2]
MEM.CHUNK -> DISCARD
CONST -> PC [imm=-1]

pop_1: .word 0xfeedfacefeedface
pop_2: .word 0xfeedfacefeedface
