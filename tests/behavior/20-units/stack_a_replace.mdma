# A synchronized exchange pops the previous value and pushes the replacement.
# expect mem64 old = 7
# expect mem64 new = 13

CONST -> STACK_A [imm=7]
CONST -> MEM.WRITE [imm=old]
STACK_A -> MEM.CHUNK, ZERO -> MEM.MASK, CONST -> STACK_A [sync, imm=13]
CONST -> MEM.WRITE [imm=new]
STACK_A -> MEM.CHUNK, ZERO -> MEM.MASK [sync]

CONST -> MEM.READ [imm=new]
MEM.CHUNK -> DISCARD
CONST -> PC [imm=-1]

old: .word 0
new: .word 0
