# PACK forwards its address, truncates each type, and preserves lanes outside the store.
# expect mem64 u8 = 0x0123456789abcd80
# expect mem64 i8 = 0x0123456789abcd80
# expect mem64 u16 = 0x0123456789ab8000
# expect mem64 i16 = 0x0123456789ab8000
# expect mem64 u32 = 0x0123456780000000
# expect mem64 i32 = 0x0123456780000000
# expect mem64 u64 = 0x8000000000000000
# expect mem64 i64 = 0x8000000000000000

CONST -> MEM.WRITE [imm=u8]
CONST -> MEM.CHUNK, ZERO -> MEM.MASK [imm=0x123456789abcdef]
CONST -> PACK.ADDR [imm=u8]
CONST -> PACK.TYPE [imm=0]
CONST -> PACK.VALUE [imm=0x180]
PACK.ADDR -> MEM.WRITE, PACK.CHUNK -> MEM.CHUNK, PACK.MASK -> MEM.MASK [sync]

CONST -> MEM.WRITE [imm=i8]
CONST -> MEM.CHUNK, ZERO -> MEM.MASK [imm=0x123456789abcdef]
CONST -> PACK.ADDR [imm=i8]
CONST -> PACK.TYPE [imm=1]
CONST -> PACK.VALUE [imm=0x180]
PACK.ADDR -> MEM.WRITE, PACK.CHUNK -> MEM.CHUNK, PACK.MASK -> MEM.MASK [sync]

CONST -> MEM.WRITE [imm=u16]
CONST -> MEM.CHUNK, ZERO -> MEM.MASK [imm=0x123456789abcdef]
CONST -> PACK.ADDR [imm=u16]
CONST -> PACK.TYPE [imm=2]
CONST -> PACK.VALUE [imm=0x18000]
PACK.ADDR -> MEM.WRITE, PACK.CHUNK -> MEM.CHUNK, PACK.MASK -> MEM.MASK [sync]

CONST -> MEM.WRITE [imm=i16]
CONST -> MEM.CHUNK, ZERO -> MEM.MASK [imm=0x123456789abcdef]
CONST -> PACK.ADDR [imm=i16]
CONST -> PACK.TYPE [imm=3]
CONST -> PACK.VALUE [imm=0x18000]
PACK.ADDR -> MEM.WRITE, PACK.CHUNK -> MEM.CHUNK, PACK.MASK -> MEM.MASK [sync]

CONST -> MEM.WRITE [imm=u32]
CONST -> MEM.CHUNK, ZERO -> MEM.MASK [imm=0x123456789abcdef]
CONST -> PACK.ADDR [imm=u32]
CONST -> PACK.TYPE [imm=4]
CONST -> PACK.VALUE [imm=0x180000000]
PACK.ADDR -> MEM.WRITE, PACK.CHUNK -> MEM.CHUNK, PACK.MASK -> MEM.MASK [sync]

CONST -> MEM.WRITE [imm=i32]
CONST -> MEM.CHUNK, ZERO -> MEM.MASK [imm=0x123456789abcdef]
CONST -> PACK.ADDR [imm=i32]
CONST -> PACK.TYPE [imm=5]
CONST -> PACK.VALUE [imm=0x180000000]
PACK.ADDR -> MEM.WRITE, PACK.CHUNK -> MEM.CHUNK, PACK.MASK -> MEM.MASK [sync]

CONST -> PACK.ADDR [imm=u64]
CONST -> PACK.TYPE [imm=6]
CONST -> PACK.VALUE [imm=0x8000000000000000]
PACK.ADDR -> MEM.WRITE, PACK.CHUNK -> MEM.CHUNK, PACK.MASK -> MEM.MASK [sync]

CONST -> PACK.ADDR [imm=i64]
CONST -> PACK.TYPE [imm=7]
CONST -> PACK.VALUE [imm=0x8000000000000000]
PACK.ADDR -> MEM.WRITE, PACK.CHUNK -> MEM.CHUNK, PACK.MASK -> MEM.MASK [sync]

CONST -> MEM.READ [imm=i64]
MEM.CHUNK -> DISCARD
CONST -> PC [imm=-1]

u8: .word 0
i8: .word 0
u16: .word 0
i16: .word 0
u32: .word 0
i32: .word 0
u64: .word 0
i64: .word 0
