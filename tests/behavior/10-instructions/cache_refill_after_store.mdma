# Warm a branch, overwrite it with a halt, then jump to the patched address.
# expect mem64 warm = 0x3fff000000f80001

CONST -> PC [imm=warm]

patch:
CONST -> MEM.READ [imm=replacement]
CONST -> MEM.WRITE [imm=warm]
MEM.CHUNK -> MEM.CHUNK, ZERO -> MEM.MASK [sync]
CONST -> MEM.READ [imm=warm]
MEM.CHUNK -> DISCARD
CONST -> PC [imm=warm]

warm:
CONST -> PC [imm=patch]

replacement:
CONST -> PC [imm=-1]
