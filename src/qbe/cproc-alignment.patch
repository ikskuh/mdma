+unsigned
+exprptralign(struct expr *e)
+{
+	unsigned a, b;
+	if (e->type->kind != TYPEPOINTER)
+		return 1;
+	if (e->alignment)
+		return e->alignment;
+	switch (e->kind) {
+	case EXPRIDENT: case EXPRCALL:
+		break;
+	case EXPRUNARY:
+		if (e->op == TMUL)
+			break; /* A pointer value loaded from an object. */
+		return 1;
+	case EXPRBINARY:
+		if (e->op != TADD && e->op != TSUB)
+			return 1;
+		a = exprptralign(e->u.binary.l);
+		b = e->type->base->align;
+		return a < b ? a : b;
+	case EXPRCOND:
+		a = exprptralign(e->u.cond.t);
+		b = exprptralign(e->u.cond.f);
+		return a < b ? a : b;
+	default:
+		return 1;
+	}
+	return e->type->base->align ? e->type->base->align : 1;
+}
