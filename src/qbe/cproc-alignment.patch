+/* A named copy is valid QBE and carries an optional MDMA alignment promise. */
+static struct value *
+accessaddr(struct func *f, struct lvalue lval, unsigned bytes)
+{
+	if (bytes < 2 || lval.align < 2 || (lval.addr->kind & 0xf) == VALUE_GLOBAL ||
+	    (lval.addr->kind == VALUE_TEMP && lval.addr->known_align >= lval.align))
+		return lval.addr;
+	struct value *addr = funcinst(f, ICOPY, ptrclass, lval.addr, NULL);
+	addr->u.name = lval.align >= 8 ? "__mdma_a8" : lval.align >= 4 ? "__mdma_a4" : "__mdma_a2";
+	return addr;
+}
