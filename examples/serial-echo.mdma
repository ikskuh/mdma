# Echo two received bytes over the byte-wide USART at MMIO address 0xfffffff8.
# Check that a masked BRAM store can be read back on the same system.
CONST -> MEM.WRITE [imm=cell]
CONST -> MEM.CHUNK, ZERO -> MEM.MASK [imm=0x123456789abcdef0]
CONST -> MEM.WRITE [imm=cell]
CONST -> MEM.CHUNK [imm=0x99]
CONST -> MEM.MASK [imm=0xfe]
CONST -> MEM.READ [imm=cell]
CONST -> MEM.WRITE [imm=readback]
MEM.CHUNK -> MEM.CHUNK, ZERO -> MEM.MASK [sync]

CONST -> MEM.READ, CONST -> MEM.WRITE [imm=0xfffffff8]
MEM.CHUNK -> MEM.CHUNK, ZERO -> MEM.MASK [sync]
CONST -> MEM.READ, CONST -> MEM.WRITE [imm=0xfffffff8]
MEM.CHUNK -> MEM.CHUNK, ZERO -> MEM.MASK [sync]
# Read status after the two sends to order them before halt.
CONST -> MEM.READ [imm=0xfffffff0]
MEM.CHUNK -> DISCARD
CONST -> PC [imm=-1]

cell: .word 0
readback: .word 0
